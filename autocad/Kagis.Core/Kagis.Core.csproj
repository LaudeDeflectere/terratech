<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared logic (STAC search, tile download, engine call). netstandard2.0 so that the
       .NET Framework 4.8 AutoCAD plugin and the .NET 8 test project can both use it. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Kagis.Core</RootNamespace>
    <AssemblyName>Kagis.Core</AssemblyName>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
</Project>
